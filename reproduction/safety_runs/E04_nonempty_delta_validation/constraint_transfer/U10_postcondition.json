    "delta": {
      "stage": "U06",
      "reference": "position/23/frame/0/U06/raw_response",
      "raw_text": "```python\n# Additional constraints based on line-by-line simulation\n\n# fraggap is computed as: if (skb) fraggap = skb->len - maxfraglen; else fraggap = 0\n# Since skb_prev == 0, we are in the alloc_new_skb path.\n# Model both branches: skb NULL => fraggap == 0; skb non-NULL => fraggap == skb->len - maxfraglen\nskb=Int('skb')\nmaxfraglen=Int('maxfraglen')\ns.add(Or(And(skb == 0, fraggap == 0),\n         And(skb != 0, fraggap == skb - maxfraglen)))\n\n# Condition at line 270: if (fraggap) — the branch is taken, so fraggap != 0\ns.add(fraggap != 0)\n\n# Since fraggap != 0, skb must be non-NULL (from the Or above)\ns.add(skb != 0)\n```",
      "raw_sha256": "2400bd4f63661a904b52a137651a0c86eb4239e95ac5432e98169aae23bc3c69",
      "provenance_scope": "caller-bound response; hash is not an independent semantic attestation"
    },
    "final": {
      "stage": "Final",
      "reference": "U10/output",
      "raw_text": "def check_constraints():\n    from z3 import Int, Solver, And, Or, sat\n\n    s = Solver()\n\n    fraggap = Int('fraggap')\n    skb_prev = Int('skb_prev')\n    skb = Int('skb')\n    maxfraglen = Int('maxfraglen')\n\n    # BASE constraints\n    s.add(Or(fraggap == 0, fraggap != 0))\n    s.add(skb_prev == 0)\n\n    # DELTA constraints\n    s.add(Or(And(skb == 0, fraggap == 0),\n             And(skb != 0, fraggap == skb - maxfraglen)))\n    s.add(fraggap != 0)\n    s.add(skb != 0)\n\n    return s.check() == sat",
      "raw_sha256": "e360770424493529a8de048b7bb2241ec475cbd703a429e9c04fab01dab14b23",
      "provenance_scope": "caller-bound response; hash is not an independent semantic attestation"
    }
  },
