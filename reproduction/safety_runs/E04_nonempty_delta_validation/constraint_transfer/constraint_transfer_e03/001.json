    "delta": {
      "stage": "U06",
      "reference": "position/23/frame/0/U06/raw_response",
      "raw_text": "```python\n# Additional constraints based on line-by-line simulation\n\n# fraggap is computed as: if (skb) fraggap = skb->len - maxfraglen; else fraggap = 0\n# Since skb_prev == 0, we are in the alloc_new_skb path.\n# Model both branches: skb NULL => fraggap == 0; skb non-NULL => fraggap == skb->len - maxfraglen\nskb=Int('skb')\nmaxfraglen=Int('maxfraglen')\ns.add(Or(And(skb == 0, fraggap == 0),\n         And(skb != 0, fraggap == skb - maxfraglen)))\n\n# Condition at line 270: if (fraggap) — the branch is taken, so fraggap != 0\ns.add(fraggap != 0)\n\n# Since fraggap != 0, skb must be non-NULL (from the Or above)\ns.add(skb != 0)\n```",
      "raw_sha256": "2400bd4f63661a904b52a137651a0c86eb4239e95ac5432e98169aae23bc3c69",
      "provenance_scope": "caller-bound response; hash is not an independent semantic attestation"
    },
    "final": {
      "stage": "Final",
      "reference": "deterministic_U02_code_plus_U06_code",
      "raw_text": "# E03 BEGIN U02 BASE raw_sha256=beff74bf8da49808fb5577082e033e25a93e957dc73fa51a800253364ac99cd3\nfraggap=Int('fraggap')\nskb_prev=Int('skb_prev')\ns.add(Or(fraggap == 0, fraggap != 0))\ns.add(skb_prev == 0)\n\n# E03 END U02 BASE\n# E03 BEGIN U06 DELTA raw_sha256=2400bd4f63661a904b52a137651a0c86eb4239e95ac5432e98169aae23bc3c69\n# Additional constraints based on line-by-line simulation\n\n# fraggap is computed as: if (skb) fraggap = skb->len - maxfraglen; else fraggap = 0\n# Since skb_prev == 0, we are in the alloc_new_skb path.\n# Model both branches: skb NULL => fraggap == 0; skb non-NULL => fraggap == skb->len - maxfraglen\nskb=Int('skb')\nmaxfraglen=Int('maxfraglen')\ns.add(Or(And(skb == 0, fraggap == 0),\n         And(skb != 0, fraggap == skb - maxfraglen)))\n\n# Condition at line 270: if (fraggap) — the branch is taken, so fraggap != 0\ns.add(fraggap != 0)\n\n# Since fraggap != 0, skb must be non-NULL (from the Or above)\ns.add(skb != 0)\n\n# E03 END U06 DELTA\n",
      "raw_sha256": "f24166bace83c56c44b6d0a4e2285a49ab78e5443dbbefa812709c146e13adcb",
      "provenance_scope": "caller-bound response; hash is not an independent semantic attestation"
