+                self.assertEqual(decide(bundle, review)['verdict'], 'UNKNOWN')
+
+    def test_wrong_source_line_or_hash_prevents_filter(self):
+        for field, bad in [('start_line', 0), ('source_sha256', '0'*64), ('end_line', 999)]:
